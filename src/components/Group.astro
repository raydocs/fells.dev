---
import { agentMarks } from "../data/icons";
import type { Dict } from "../i18n/en";
import { groupPlans } from "../data/catalog";
interface Props { t: Dict }
const { group: g, assure } = Astro.props.t;
---
<section class="section group" id="group">
  <div class="wrap">
    <div class="reveal">
      <span class="kicker">{g.kicker}</span>
      <h2 class="h2">{g.title}</h2>
      <p class="lead">{g.sub}</p>
    </div>
    <div class="cards">
      {groupPlans.map((gp, i) => {
        const c = g.cards[i];
        return (
          <article class="card reveal" style={`--hue:${gp.hue};transition-delay:${i * 90}ms`} data-group={gp.id}>
            <span class="watermark" aria-hidden="true"><Fragment set:html={agentMarks[gp.id]?.svg ?? gp.glyph} /></span>
            <div class="top">
              <span class="mark" aria-hidden="true"><Fragment set:html={agentMarks[gp.id]?.svg ?? gp.glyph} /></span>
              <span class="maker">{c.maker}</span>
              <span class="soon">{g.soon}</span>
            </div>
            <h3>{c.name}</h3>
            <p class="tagline">{c.tagline}</p>
            <p class="model"><b>{c.model}</b><span>{c.modelState}</span></p>
            <p class="bt">{g.benefitsTitle}</p>
            <ul>{c.benefits.map((b) => <li>{b}</li>)}</ul>
            <button type="button" class="btn btn-ghost reserve" data-reserve>{g.reserve}</button>
          </article>
        );
      })}
    </div>
    <p class="note reveal">{g.note}</p>

    <ul class="assure reveal">
      {assure.map((a) => (
        <li><h3>{a.title}</h3><p>{a.body}</p></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .group { padding-top: 40px; }
  .cards { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card {
    position: relative; overflow: hidden; display: flex; flex-direction: column; padding: 28px; border-radius: var(--radius-lg);
    border: 1px dashed var(--line-2);
    background: radial-gradient(100% 60% at 100% 0%, color-mix(in oklab, var(--hue) 16%, transparent), transparent 60%), var(--panel);
  }
  .watermark { position: absolute; right: -10px; top: -30px; font-size: 200px; line-height: 1; font-weight: 700; color: var(--hue); opacity: 0.06; pointer-events: none; }
  .top { position: relative; display: flex; align-items: center; gap: 10px; }
  .mark { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: #fff; background: color-mix(in oklab, var(--hue) 65%, #1a1d25); }
  .maker { font-size: 13px; color: var(--muted); }
  .soon { margin-left: auto; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--ember-2); }
  h3 { position: relative; margin: 18px 0 0; font-size: 26px; font-weight: 650; letter-spacing: -0.02em; }
  .tagline { margin: 6px 0 0; color: var(--muted); }
  .model { display: flex; align-items: center; gap: 10px; margin: 18px 0 0; padding: 10px 14px; border-radius: 12px; background: rgba(0, 0, 0, 0.3); border: 1px solid var(--line); font-size: 14px; }
  .model span { margin-left: auto; font-size: 12px; color: var(--moss); }
  .bt { margin: 20px 0 0; font: 500 12px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  ul { list-style: none; padding: 0; margin: 10px 0 22px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  li { font-size: 13.5px; color: var(--muted); display: flex; gap: 8px; }
  .card li::before { content: "✓"; color: var(--moss); flex: none; }
  .reserve { margin-top: auto; width: 100%; }
  .reserve.done { border-color: rgba(134, 214, 173, 0.5); color: var(--moss); }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--dim); max-width: 90ch; }

  .assure { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .assure li { display: block; padding: 24px 20px 0 0; }
  .assure li::before { content: none; }
  .assure li + li { padding-left: 20px; border-left: 1px solid var(--line); }
  .assure h3 { margin: 0 0 6px; font-size: 16px; font-weight: 600; letter-spacing: 0; }
  .assure p { margin: 0; color: var(--muted); font-size: 14px; }
  @media (max-width: 960px) { .cards { grid-template-columns: 1fr; } .assure { grid-template-columns: 1fr 1fr; gap: 20px 0; } .assure li:nth-child(3) { border-left: 0; padding-left: 0; } }
  @media (max-width: 520px) { ul { grid-template-columns: 1fr; } .assure { grid-template-columns: 1fr; } .assure li + li { border-left: 0; padding-left: 0; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>("[data-group]").forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>("[data-reserve]")!;
    btn.addEventListener("click", () => {
      // No backend yet: route to the waitlist form.
      btn.classList.add("done");
      btn.textContent = "✓";
      document.getElementById("early")?.scrollIntoView({ behavior: "smooth" });
    });
  });
</script>
